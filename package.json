{
  "name": "markdown-studio",
  "version": "0.3.0",
  "description": "Desktopowy edytor i podgląd Markdown dla Windows z eksportem PDF, HTML i DOCX.",
  "main": "dist-electron/main/main.js",
  "author": "Marek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zetmar-collab/markdown-studio.git"
  },
  "homepage": "https://github.com/zetmar-collab/markdown-studio#readme",
  "bugs": {
    "url": "https://github.com/zetmar-collab/markdown-studio/issues"
  },
  "type": "module",
  "scripts": {
    "icon": "node scripts/make-icon.mjs && node scripts/make-appx-assets.mjs",
    "predev": "npm run icon",
    "prebuild": "npm run icon",
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && electron .",
    "build": "npm run typecheck && npm run lint && vite build && npm run build:electron",
    "build:electron": "node scripts/clean-electron-out.mjs && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "dist": "npm run dist:all",
    "dist:setup": "node scripts/stop-running-app.mjs && npm run build && electron-builder --win nsis --publish never",
    "dist:portable": "node scripts/stop-running-app.mjs && npm run build && electron-builder --win portable --publish never",
    "dist:all": "node scripts/stop-running-app.mjs && npm run build && electron-builder --win nsis portable --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "dist:store": "node scripts/build-appx.mjs --store",
    "dist:store-test": "node scripts/build-appx.mjs --test",
    "dist:store-all": "node scripts/build-appx.mjs --store --test",
    "store:publish": "node scripts/store-publish.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.4.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.8",
    "@uiw/react-codemirror": "^4.25.3",
    "@vscode/markdown-it-katex": "^1.1.2",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "html-to-docx": "^1.8.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.561.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "png-to-ico": "^2.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.2.7",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.3"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "zetmar-collab",
        "repo": "markdown-studio"
      }
    ],
    "appId": "pl.marek.markdownstudio",
    "productName": "Studio Markdown",
    "icon": "build/icon.ico",
    "directories": {
      "output": "out/pack"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable",
        "appx"
      ],
      "artifactName": "Studio-Markdown-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Studio-Markdown-${version}-Portable-${arch}.exe"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "StudioMarkdown",
        "description": "Dokument Markdown",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "StudioMarkdownMarkdown",
        "description": "Dokument Markdown",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "StudioMarkdownMdown",
        "description": "Dokument Markdown",
        "role": "Editor"
      },
      {
        "ext": "mkd",
        "name": "StudioMarkdownMkd",
        "description": "Dokument Markdown",
        "role": "Editor"
      }
    ],
    "nsis": {
      "artifactName": "Studio-Markdown-${version}-Setup-${arch}.exe",
      "guid": "8f4c2a1b-9e3d-4f5a-b6c7-1d2e3f4a5b6c",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Studio Markdown",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Studio Markdown",
      "perMachine": false,
      "allowElevation": true,
      "installerLanguages": [
        "pl_PL",
        "en_US"
      ]
    },
    "appx": {
      "identityName": "MarekZettel-zetmar.StudioMarkdown",
      "publisher": "CN=15A53D32-C868-48EE-B700-5DBB5449CA1B",
      "publisherDisplayName": "Marek Zettel - zetmar",
      "applicationId": "StudioMarkdown",
      "displayName": "Studio Markdown",
      "backgroundColor": "#101114",
      "showNameOnTiles": true,
      "languages": [
        "pl-PL",
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0",
      "electronUpdaterAware": false,
      "artifactName": "StudioMarkdown-${version}-${arch}.${ext}"
    }
  }
}
